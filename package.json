{
  "name": "research-workbench",
  "private": true,
  "version": "0.1.0",
  "description": "长期科研人机协作工作台 — 阶段A可理解样机",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.13"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "preview": "npm run preview -w apps/web",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "contracts:check": "node scripts/check-contracts.ts",
    "contracts:types": "node scripts/gen-contract-types.ts",
    "fixtures": "node fixtures/stage-a/build.ts && node fixtures/mini/build.ts && node scripts/validate-fixtures.ts",
    "fixtures:validate": "node scripts/validate-fixtures.ts",
    "check": "npm run contracts:check && npm run fixtures:validate && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
